DATABASE_URL="postgres://postgres:postgres@localhost:5432/1mail_development"
PORT=3300
HOST=0.0.0.0
JWT_SECRET=dev-secret-change-in-production
APP_URL=http://localhost:3300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@1mail.dev


# Base64-encoded Tink keyset for encrypting stored provider credentials
# (AES-256-GCM, rotation-ready). Generate one with: make gen-encryption-key
ENCRYPTION_KEY=

# OpenTelemetry: metrics are always exposed at /metrics (Prometheus pull —
# scrape with VictoriaMetrics/Prometheus). Set an OTLP endpoint to ALSO push
# traces + metrics to a collector (leave unset in prod self-hosted).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

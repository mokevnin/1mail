# Sample env for the docker compose dev stack.
# The app is reached at https://1mail.localhost (TLS terminated by Caddy).
#
# Service hostnames below refer to compose services (db, mailpit). For a backend
# running on the HOST during the rewrite, use host.docker.internal instead of db.

DATABASE_URL="postgres://postgres:postgres@db:5432/1mail_development"
APP_URL=https://1mail.localhost
PORT=3300
HOST=0.0.0.0

JWT_SECRET=dev-secret-change-in-production

# Apply embedded DB migrations on startup. The binary/image is self-contained
# (no atlas CLI needed). Runtime tracks applied versions in its own
# schema_migrations table.
# Caveats:
#  - Multi-replica deploys: prefer running `1mail migrate` as a single separate
#    step instead, so replicas don't race to apply on startup.
#  - Only point this at a fresh DB or one this binary already manages. A DB
#    previously migrated by the atlas CLI (dev flow) tracks state in
#    atlas_schema_revisions, not schema_migrations, so AUTO_MIGRATE would try to
#    re-apply everything.
AUTO_MIGRATE=true

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@1mail.dev

# Push traces + metrics to the local grafana/otel-lgtm stack (Grafana at
# http://localhost:3001). Metrics are also always exposed at /metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Base64-encoded Tink keyset for encrypting stored provider credentials
# (AES-256-GCM, rotation-ready). Mint one with secrets.GenerateKeysetBase64.
ENCRYPTION_KEY=CIamsc4JEmQKWAowdHlwZS5nb29nbGVhcGlzLmNvbS9nb29nbGUuY3J5cHRvLnRpbmsuQWVzR2NtS2V5EiIaIIOWohIqGhyD2NeiOazlLrnrHqCirukTjCjD1iMFPqiEGAEQARiGprHOCSAB

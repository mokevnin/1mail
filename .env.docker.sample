# Sample env for the docker compose dev stack.
# The app is reached at https://1mail.localhost (TLS terminated by Caddy).
#
# Service hostnames below refer to compose services (db, mailpit). For a backend
# running on the HOST during the rewrite, use host.docker.internal instead of db.

DATABASE_URL="postgres://postgres:postgres@db:5432/1mail_development"
APP_URL=https://1mail.localhost
PORT=3300
HOST=0.0.0.0

JWT_SECRET=dev-secret-change-in-production

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@1mail.dev
